{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/sokoban/levels.schema.json",
  "title": "Levels",
  "type": "object",
  "required": ["mechanic", "levels"],
  "additionalProperties": false,
  "properties": {
    "mechanic": { "$ref": "#/$defs/id" },
    "levels": {
      "type": "array",
      "items": { "$ref": "#/$defs/level" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "level": {
      "type": "object",
      "required": [
        "id",
        "title",
        "layout"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "layout": { "type": "string", "minLength": 1 },
        "win": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": true,
          "properties": {
            "type": { "$ref": "#/$defs/id" }
          }
        },
        "legend": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "$ref": "#/$defs/id" },
              {
                "type": "array",
                "items": { "$ref": "#/$defs/id" },
                "minItems": 1
              }
            ]
          }
        },
        "expected_trace": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedStep" }
        },
        "expected_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "design_notes": { "type": "string" },
        "lineage": { "$ref": "#/$defs/levelLineage" },
        "analysis": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "levelLineage": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "source_level_id": { "type": "string", "minLength": 1 },
        "source_candidate_id": { "type": "string", "minLength": 1 },
        "source_file": { "type": "string", "minLength": 1 },
        "created_by": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 }
      }
    },
    "expectedStep": {
      "type": "object",
      "required": ["input"],
      "additionalProperties": false,
      "properties": {
        "input": { "$ref": "#/$defs/id" },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "notes": { "type": "string" }
      }
    }
  }
}
